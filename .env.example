APP_NAME=ORGDATE
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://orgdate.com

APP_LOCALE=de
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=de_DE

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL — lokal via docker compose up -d (Container orgdate-pgsql, Port 5433)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=orgdate
DB_USERNAME=orgdate
DB_PASSWORD=orgdate

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@orgdate.com"
MAIL_FROM_NAME="${APP_NAME}"

# KI-Extraktion (optional). Ohne Key läuft die App im Heuristik-Fallback
# (Spec Abschnitt 7: "Die KI ist Beschleuniger, nie Voraussetzung").
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
AI_DAILY_BUDGET=500

VITE_APP_NAME="${APP_NAME}"

BRAND_DOMAIN=orgdate.com
BRAND_EMAIL=hello@orgdate.com

# Search Console: nur der Wert aus dem content-Attribut
GOOGLE_SITE_VERIFICATION=
